{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Altura das infos = 20 linhas, igual ao logo do Ubuntu (display compacto numa linha só)
    // roxo do portfólio no lugar do vermelho/laranja padrao do logo do Ubuntu
    "logo": {
        "color": { "1": "38;2;172;75;255", "2": "38;2;217;179;255" }
    },
    "display": {
        "color": { "keys": "38;2;192;126;255", "title": "38;2;172;75;255", "separator": "38;2;63;63;70" }
    },
    "modules": [
        "title", "separator",
        "os", "kernel", "uptime", "packages", "processes", "shell", "terminal",
        "wm",
        "cpu", "gpu", { "type": "display", "compactType": "original" }, "memory", "swap", "disk", "battery",
        "wifi", "localip", "datetime"
    ]
}
