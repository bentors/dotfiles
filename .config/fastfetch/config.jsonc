{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Padrão do fastfetch sem: host, display, battery, locale, localip, icons, font, cursor, terminal, terminalfont
    // roxo no lugar do vermelho/laranja padrao do logo do Ubuntu
    "logo": {
        "color": { "1": "38;2;139;92;246", "2": "38;2;187;154;247" }
    },
    "display": {
        "color": { "keys": "38;2;187;154;247", "title": "38;2;139;92;246" }
    },
    "modules": [
        "title", "separator",
        "os", "kernel", "uptime", "packages", "shell",
        "de", "wm", "wmtheme", "theme",
        "cpu", "gpu", "memory", "swap", "disk"
    ]
}
