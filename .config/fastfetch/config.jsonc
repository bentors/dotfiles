{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // logo "BR." do portfólio (bentorangel.vercel.app): letras claras, ponto roxo,
    // centralizado na altura das infos (20 linhas)
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;244;244;245", "2": "38;2;172;75;255" },
        "padding": { "top": 7, "left": 2, "right": 4 }
    },
    "display": {
        "color": { "keys": "38;2;192;126;255", "title": "38;2;172;75;255", "separator": "38;2;63;63;70" }
    },
    "modules": [
        "title", "separator",
        "os", "kernel", "uptime", "packages", "processes", "shell", "terminal",
        "wm",
        "cpu", "gpu", { "type": "display", "compactType": "original" }, "memory", "swap", "disk", "battery",
        "wifi", "localip", "datetime"
    ]
}
