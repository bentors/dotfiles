#!/usr/bin/env bash
# Wallpaper picker for Hyprland, backed by swaybg.
#
#   wallpaper            open the rofi thumbnail grid
#   wallpaper NAME       apply a wallpaper already stored in the library
#   wallpaper /path.png  import an image into the library, then apply it
#   wallpaper --list     print the library contents
#   wallpaper --none     back to Hyprland's plain gray background
#
# The active image is kept at $ACTIVE so hyprland.conf can point at a fixed
# path; the library keeps the originals so nothing is lost on a switch.

set -euo pipefail

LIB="$HOME/.config/hypr/wallpapers"
# wallpaper.png é a foto da tela de bloqueio; o fundo da área de trabalho fica separado
ACTIVE="$HOME/.config/hypr/desktop-wallpaper.png"
MODE="fill"

mkdir -p "$LIB"

apply() {
  local img=$1
  cp -f "$img" "$ACTIVE"
  pkill -x swaybg 2>/dev/null || true
  setsid -f swaybg -i "$ACTIVE" -m "$MODE" >/dev/null 2>&1
  # Best effort: there may be no notification daemon running, and set -e must
  # not turn that into a failed wallpaper switch.
  command -v notify-send >/dev/null &&
    notify-send -u low -i "$ACTIVE" "Wallpaper" "$(basename "$img")" 2>/dev/null || true
}

GRAY="Cinza padrão"

# acha NOME.* na biblioteca comparando literalmente (sem glob); várias extensões: a primeira em ordem alfabética
find_img() {
  find "$LIB" -maxdepth 1 -type f -print | LC_ALL=C sort | while IFS= read -r f; do
    b=${f##*/}
    case ${b,,} in *.png|*.jpg|*.jpeg|*.webp) ;; *) continue ;; esac
    [ "${b%.*}" = "$1" ] && { printf '%s\n' "$f"; break; }
  done || true
}

none() {
  pkill -x swaybg 2>/dev/null || true
  rm -f "$ACTIVE"
}

case ${1-} in
  --none)
    none
    exit 0
    ;;
  --list|-l)
    find "$LIB" -maxdepth 1 -type f \
      \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
      -printf '%f\n' | sort
    exit 0
    ;;
  '')
    # The rofi icon protocol is LABEL \0 icon \x1f PATH. Those NUL bytes cannot
    # survive a shell variable, so the list is piped straight into rofi.
    entries() {
      find "$LIB" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        | sort \
        | while IFS= read -r f; do
            printf '%s\0icon\x1f%s\n' "$(basename "${f%.*}")" "$f"
          done
    }

    if [ -z "$(entries)" ]; then
      echo "Nenhuma imagem em $LIB" >&2
      command -v notify-send >/dev/null && notify-send -u low "Wallpaper" "Nenhuma imagem em $LIB" || true
      exit 1
    fi

    # Flat swatch so the "no wallpaper" entry has a thumbnail like the others
    gray_icon="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper/gray.png"
    if [ ! -s "$gray_icon" ]; then
      mkdir -p "${gray_icon%/*}"
      magick -size 320x180 xc:'#3a3a3a' "$gray_icon" 2>/dev/null || true
    fi

    choice=$( { printf '%s\0icon\x1f%s\n' "$GRAY" "$gray_icon"; entries; } | rofi -dmenu -i -p "Wallpaper" -show-icons \
                            -theme "$HOME/.config/rofi/wallpaper.rasi") || exit 0
    [ -z "$choice" ] && exit 0
    [ "$choice" = "$GRAY" ] && { none; exit 0; }

    img=$(find_img "$choice")
    [ -z "$img" ] && { echo "Nao achei '$choice' em $LIB" >&2; exit 1; }
    apply "$img"
    ;;
  /*|./*|~/*|*/*)
    src=${1/#\~/$HOME}
    [ -f "$src" ] || { echo "Arquivo nao encontrado: $src" >&2; exit 1; }
    dst="$LIB/$(basename "$src")"
    # já é o arquivo da biblioteca (ou idêntico): nada a copiar; cp com origem == destino abortaria sob set -e
    if [ -e "$dst" ] && ! [ "$src" -ef "$dst" ] && ! cmp -s "$src" "$dst"; then
      msg="Ja existe outra imagem com o nome $(basename "$src") em $LIB"
      echo "$msg" >&2
      command -v notify-send >/dev/null && notify-send -u low "Wallpaper" "$msg" || true
      exit 1
    fi
    [ -e "$dst" ] || cp "$src" "$dst"
    apply "$dst"
    ;;
  *)
    # caminho relativo de um arquivo existente (ex.: foto.png): importa; senão é nome da biblioteca
    if [ -f "$1" ]; then exec "$0" "./$1"; fi
    img=$(find_img "$1")
    [ -z "$img" ] && { echo "Nao achei '$1' em $LIB" >&2; "$0" --list >&2; exit 1; }
    apply "$img"
    ;;
esac
