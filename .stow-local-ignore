# repo metadata, never linked into $HOME
\.git
^/\.gitignore
^/README.*
^/LICENSE
^/\.stowrc
^/\.stow-local-ignore
^/packages\.txt

# this file replaces stow's default ignore list, so mirror the .gitignore junk
.*\.bak.*
__pycache__
# editor junk (was in stow's default list, which this file replaces) and vim swap files
.*~
\.\#.*
\#.*\#
\..*\.sw[po]

# rewritten at runtime by tools/scripts (replacing links); copied, not linked
^/\.claude/settings\.json
^/\.config/waybar/art\.css
^/\.config/mimeapps\.list
^/\.config/vicinae/settings\.json
^/screenshots
